{
  MISSKEY_TOKENS: {
    type: "array",
    required: false,
    non_empty: false,
    items: {
      type: "object",
      properties: {
        host: {
          type: "string",
          required: true,
          non_empty: true,
          disallow: ["YOUR_TOKEN"],
        },
        token: {
          type: "string",
          required: true,
          non_empty: true,
          disallow: ["YOUR_HOST"],
        }
      }
    }
  },
}
